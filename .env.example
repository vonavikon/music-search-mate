# --- Telegram ---
# Bot token from @BotFather (required)
BOT_TOKEN=

# --- LLM gateway (required): any OpenAI-compatible endpoint ---
BOTHUB_API_KEY=
# Defaults shown; set your own gateway and model names if needed
# BOTHUB_BASE=https://openai.bothub.chat/v1
# LLM_MODEL=deepseek-v4-pro
# LLM_MODEL_SONAR=sonar   # web-grounded model for the fact button; empty = off

# --- Rate limits and quotas (optional, defaults from config.py shown) ---
# MAX_CONCURRENT_DOWNLOADS=2
# TEMP_TTL_MINUTES=30
# USER_RATE_LIMIT_PER_HOUR=20
# SEARCH_DAILY_LIMIT=200
# URL_DAILY_LIMIT=200
# GLOBAL_DAILY_SEARCH_BUDGET=1000
# FACT_DAILY_LIMIT=2
# GLOBAL_DAILY_FACT_BUDGET=125
# VIDEO_DAILY_LIMIT=30
# SENDS_DAILY_LIMIT=100
# URL_ALLOWED_HOSTS=youtube.com,youtu.be,music.youtube.com,soundcloud.com,bandcamp.com,vk.com
# DATA_RETENTION_DAYS=180

# --- Access control ---
# Comma-separated Telegram user IDs; empty = open to everyone
ALLOWED_USER_IDS=

# --- Last.fm (optional; empty = Last.fm layer is skipped) ---
LASTFM_API_KEY=

# --- Langfuse tracing (optional; empty keys = tracing off) ---
# LANGFUSE_HOST points to your Langfuse instance URL
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=
# LANGFUSE_ENVIRONMENT=development

# --- Local Bot API server (optional): files up to 2 GB instead of 50 MB ---
# Run the tgapi service from docker-compose.public.yml with --profile local-api
# and set TELEGRAM_LOCAL=1. The bot finds the server via LOCAL_BOT_API_URL
# (empty = regular cloud api.telegram.org).
# api_id/api_hash: create your own app at my.telegram.org (never use someone
# else's). On first switch from the cloud API, call logOut once so updates stop
# going to api.telegram.org:
#   curl "https://api.telegram.org/bot$BOT_TOKEN/logOut"
TG_API_ID=
TG_API_HASH=
TELEGRAM_LOCAL=1
# LOCAL_BOT_API_URL=http://tgapi:8081
# VIDEO_MAX_FILESIZE=2000M   # yt-dlp max file size: 2000M with local Bot API, 50M without
